<launch>

    <arg name="core_param_path" value="$(find elevation_mapping_cupy)/config/kyon/kyon_core_param.yaml"/>

    <arg name="elevation_mapping_config_path" value="$(find elevation_mapping_cupy)/config/kyon/kyon_elevation_mapping_config.yaml"/>

    <!-- Parameter file for ConvexPlaneDecompositionRos -->
    <arg name="node_parameter_file" value="$(find elevation_mapping_cupy)/config/kyon/kyon_node.yaml"/>
    <arg name="parameter_file" value="$(find elevation_mapping_cupy)/config/kyon/kyon_parameter.yaml"/>

    <include file="$(find elevation_mapping_cupy)/launch/elevation_mapping_cupy.launch" pass_all_args="true"/>
    <include file="$(find convex_plane_decomposition_ros)/launch/convex_plane_decomposition.launch" pass_all_args="true"/>
    
</launch>
